{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["./conventions/biome.base.json"],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "noUnknownAtRules": "off"
      }
    }
  },
  "files": {
    "includes": [
      "**",
      "!!**/coverage",
      "!!**/dist",
      "!**/node_modules",
      "!**/playwright/results",
      "!workouts"
    ]
  }
}
