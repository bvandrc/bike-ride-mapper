{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // `paths` replaces rather than merges with the base config's, so `@/*` is
    // repeated here to keep it working in tests.
    "paths": {
      "@/*": ["../src/*"],
      "~/pw/support/*": ["./support/*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules"]
}
