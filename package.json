{
  "name": "bike-ride-mapper",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MapMyRide Mapper",
  "main": "index.js",
  "homepage": "TODO.com",
  "scripts": {
    "__c0": "====================[ Build & Development ]======================",
    "start": "yarn dev",
    "dev": "vite --open",
    "prebuild": "yarn build:workouts",
    "build": "vite build",
    "preview": "yarn build && vite preview --open",
    "preview:ci": "vite preview --strictPort",
    "__c1": "====================[ Linting & Type Checking ]==================",
    "lint": "yarn lint:fix && yarn ts:check && yarn pw:ts:check",
    "lint:fix": "npx biome check . --fix",
    "ts:check": "tsc",
    "pw:ts:check": "tsc --project playwright/tsconfig.json",
    "__c2": "====================[ Playwright Testing ]=======================",
    "test:e2e": "yarn pw:run --project=e2e",
    "test:a11y": "yarn pw:run --project=a11y --project=a11y:mobile",
    "test:lighthouse": "yarn pw:run --project=lighthouse",
    "test:lighthouse:production": "yarn pw:run --project=lighthouse:production",
    "pw:run": "playwright test",
    "pw:open": "playwright test --ui",
    "pw:report": "playwright show-report playwright/results/html",
    "__c3": "====================[ Misc ]=====================================",
    "get-data": "npx tsx ./scripts/get-workouts.ts",
    "get-mmr-token": "npx tsx ./scripts/get-mmr-token.ts",
    "build:workouts": "npx tsx ./scripts/build-workouts-ndjson.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bvandrc/TODO"
  },
  "keywords": [
    "MapMyRide"
  ],
  "author": "Blake Vandercar",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/bvandrc/TODO/issues"
  },
  "dependencies": {
    "classnames": "^2",
    "es-toolkit": "^1.44",
    "leaflet": "^1.9",
    "leaflet-polylinedecorator": "^1.6",
    "luxon": "^3.7",
    "ndjson-readablestream": "^1.4",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12",
    "@biomejs/biome": "^2.3",
    "@playwright/test": "^1.61",
    "@tailwindcss/vite": "^4.1",
    "@tmcw/togeojson": "^7",
    "@turf/simplify": "^7",
    "@types/leaflet": "^1.9",
    "@types/leaflet-polylinedecorator": "^1.6",
    "@types/luxon": "^3.4",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/xmldom": "^0.1",
    "@vitejs/plugin-react": "^6",
    "axe-core": "^4.12",
    "dotenv": "^16",
    "lighthouse": "^13.4",
    "playwright-lighthouse": "^4.0",
    "geojson": "^0.5.0",
    "tailwindcss": "^4.1",
    "tsx": "^4.20.3",
    "type-fest": "^5",
    "typescript": "^7",
    "vite": "^8",
    "xmldom": "^0.6"
  }
}
